# Safe local defaults; no credentials or secrets are used by this project.
# CLI crawl is always metadata-only; no robots bypass setting exists.
KW_NOTICE_DB_PATH=data/kw-notice.sqlite3
KW_NOTICE_LOG_LEVEL=INFO
KW_NOTICE_USER_AGENT=kw-notice-mcp/0.1 (+local metadata collector)
KW_NOTICE_MAX_PAGES=1
KW_NOTICE_MAX_DETAIL_REQUESTS=100
KW_NOTICE_MAX_DURATION_SECONDS=600
